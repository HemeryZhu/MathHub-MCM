# GEMINI_API_KEY: Required for file upload parsing (PDF, images) and AI chat.
# Get your key at https://aistudio.google.com/app/apikey
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: absolute path or command name for the local Python interpreter used by Modulus.
# Defaults to "python" on Windows and "python3" on macOS/Linux.
PYTHON_EXECUTABLE="python"

# Keep disabled for local safety. Set to "true" only when the service runs inside a hardened,
# disposable execution container and remote users are intentionally allowed to run Python.
ALLOW_REMOTE_PYTHON_EXECUTION="false"

# MCP safety controls. The five bundled stdio servers work without changing these.
# Enable only after reviewing the configured external command or remote endpoint.
ALLOW_EXTERNAL_MCP_STDIO="false"
ALLOW_REMOTE_MCP_HTTP="false"
ALLOW_REMOTE_MCP_EXECUTION="false"

# Optional web search provider. Without this key, web_search uses the more limited
# DuckDuckGo Instant Answer endpoint; fetch_url and fetch_json need no key.
BRAVE_SEARCH_API_KEY=""

# OpenAlex currently requires a free API key. Contact addresses identify this client
# to scholarly APIs and help providers contact the application owner if needed.
OPENALEX_API_KEY=""
OPENALEX_EMAIL=""
CROSSREF_MAILTO=""

# Optional GitHub token. GitHub permits anonymous public reads at a low shared rate;
# a token raises rate limits and permits reads from repositories visible to that token.
GITHUB_TOKEN=""

# Optional PostgreSQL connection. All database MCP calls run in READ ONLY transactions.
DATABASE_URL=""
DATABASE_SSL="false"

# Optional allowlisted external services. Keep credentials in separate environment variables.
# Example (single line):
# MCP_EXTERNAL_SERVICES_JSON='{"weather":{"baseUrl":"https://api.example.com","allowedMethods":["GET"],"allowedPaths":["/v1/"],"headersEnv":{"Authorization":"WEATHER_AUTH_HEADER"}}}'
MCP_EXTERNAL_SERVICES_JSON=""
